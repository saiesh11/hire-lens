ANTHROPIC_API_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server-only, full DB/storage access, bypasses RLS — never expose to the client.
# From Supabase Project Settings -> API -> service_role key.
SUPABASE_SERVICE_ROLE_KEY=
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
# Optional — GitHub profile enrichment works without it at 60 requests/hour
# (unauthenticated). Add a personal access token (no scopes needed, just
# public read access) to raise that to 5,000/hour.
GITHUB_TOKEN=
PORT=3001
